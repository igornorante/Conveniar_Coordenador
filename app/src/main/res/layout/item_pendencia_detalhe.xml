<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txt_id_pedido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pedido #0000"
            android:textColor="@color/azul_conveniar"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_info_principal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Informação principal"
            android:textColor="#333333"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/txt_info_secundaria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Informação secundária"
            android:textColor="#666666"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>