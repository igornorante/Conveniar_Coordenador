<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/layout_grupo_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/img_categoria_icone"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/icone_pedido"
                app:tint="@color/azul_conveniar"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:id="@+id/txt_titulo_grupo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Título do Grupo"
                android:textSize="14sp"
                android:textColor="#333333"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_count_grupo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="13sp"
                android:textColor="@color/azul_conveniar"
                android:textStyle="bold"
                android:background="@drawable/bg_status_pendencia"
                android:backgroundTint="#E3F2FD"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:layout_marginEnd="8dp"/>

            <ImageView
                android:id="@+id/img_chevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_down"
                app:tint="#999999"
                android:contentDescription="Expandir" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_status_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="56dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone">
            <!-- Status items will be added here dynamically -->
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>