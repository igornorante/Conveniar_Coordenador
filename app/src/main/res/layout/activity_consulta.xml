<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F7F7F7">

        <include
            android:id="@+id/header_consulta"
            layout="@layout/header_geral" />

        <TextView
            android:id="@+id/txt_titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/header_consulta"
            android:background="@color/azul_conveniar"
            android:padding="6dp"
            android:text="@string/titulo_consulta"
            android:textAlignment="center"
            android:textColor="@android:color/white"
            android:textSize="20sp" />

        <ScrollView
            android:id="@+id/scroll_conteudo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/txt_titulo">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:id="@+id/card_criterios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/criterios_consulta"
                        android:textColor="@color/azul_conveniar"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <!-- Número Pedido -->
                    <TextView
                        android:id="@+id/lbl_num_pedido"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/numero_pedido"
                        android:textSize="14sp" />
                    <EditText
                        android:id="@+id/edt_num_pedido"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:autofillHints="none"
                        android:hint="@string/numero_pedido"
                        android:layout_marginBottom="8dp"/>

                    <!-- Projeto -->
                    <TextView
                        android:id="@+id/lbl_projeto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/projeto"
                        android:textSize="14sp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <Spinner
                            android:id="@+id/spinner_projetos"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                        <CheckBox
                            android:id="@+id/chk_listar_todos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/listar_todos"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <!-- Data do Pedido -->
                    <TextView
                        android:id="@+id/lbl_data_pedido"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/data_pedido"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <EditText
                            android:id="@+id/edt_data_inicio"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/hint_data"
                            android:inputType="date"
                            android:autofillHints="none"
                            android:labelFor="@id/lbl_data_pedido" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/data_ate"
                            android:layout_gravity="center_vertical"/>
                        <EditText
                            android:id="@+id/edt_data_fim"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/hint_data"
                            android:inputType="date"
                            android:autofillHints="none"
                            android:labelFor="@id/lbl_data_pedido" />
                    </LinearLayout>

                    <!-- Produto -->
                    <TextView
                        android:id="@+id/lbl_produto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/produto"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp"/>
                    <EditText
                        android:id="@+id/edt_produto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:autofillHints="none"
                        android:hint="@string/produto"
                        android:layout_marginBottom="8dp"/>

                    <!-- Número Processo Compra -->
                    <TextView
                        android:id="@+id/lbl_num_processo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/num_processo_compra"
                        android:textSize="14sp" />
                    <EditText
                        android:id="@+id/edt_num_processo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:autofillHints="none"
                        android:hint="@string/num_processo_compra"
                        android:layout_marginBottom="8dp"/>

                    <!-- Número AF/OS -->
                    <TextView
                        android:id="@+id/lbl_num_af_os"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/num_af_os"
                        android:textSize="14sp" />
                    <EditText
                        android:id="@+id/edt_num_af_os"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:autofillHints="none"
                        android:hint="@string/num_af_os"
                        android:layout_marginBottom="8dp"/>

                    <!-- Fornecedor -->
                    <TextView
                        android:id="@+id/lbl_fornecedor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fornecedor"
                        android:textSize="14sp" />
                    <EditText
                        android:id="@+id/edt_fornecedor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:autofillHints="none"
                        android:hint="@string/fornecedor"
                        android:layout_marginBottom="4dp"/>
                    <CheckBox
                        android:id="@+id/chk_meus_pedidos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/meus_pedidos"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp"/>

                    <!-- Solicitante -->
                    <TextView
                        android:id="@+id/lbl_solicitante"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/solicitante"
                        android:textSize="14sp" />
                    <EditText
                        android:id="@+id/edt_solicitante"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:autofillHints="none"
                        android:hint="@string/solicitante"
                        android:layout_marginBottom="8dp"/>

                    <!-- Situação -->
                    <TextView
                        android:id="@+id/lbl_situacao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/situacao"
                        android:textSize="14sp" />
                    <Spinner
                        android:id="@+id/spinner_situacao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"/>

                    <Button
                        android:id="@+id/btn_consultar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/azul_conveniar"
                        android:text="@string/botao_consultar"
                        android:layout_gravity="center_horizontal"/>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view_consultas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clipToPadding="false"
                    android:paddingBottom="16dp" />

            </LinearLayout>
        </ScrollView>
    </RelativeLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#EDEDED"
        app:headerLayout="@layout/header_menu_lateral"
        app:itemIconTint="@null"
        app:itemTextColor="@color/black"
        app:menu="@menu/menu_lateral_opcoes" />

</androidx.drawerlayout.widget.DrawerLayout>