<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F8FAFC">

        <include layout="@layout/header_geral" />

        <TextView
            android:id="@+id/txt_titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/azul_conveniar"
            android:padding="8dp"
            android:text="@string/titulo_consulta"
            android:textAlignment="center"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/scroll_conteudo"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/card_criterios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@android:color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/criterios_consulta"
                        android:textColor="@color/azul_conveniar"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <!-- Tipo de Consulta -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tipo_consulta"
                        android:textColor="@color/black"
                        android:textSize="14sp" />
                    <Spinner
                        android:id="@+id/spinner_tipo_consulta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginBottom="8dp"/>

                    <!-- Número Pedido -->
                    <TextView
                        android:id="@+id/lbl_num_pedido"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/numero_pedido"
                        android:textColor="@color/black"
                        android:textSize="14sp" />
                    <EditText
                        android:id="@+id/edt_num_pedido"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:autofillHints="none"
                        android:hint="@string/numero_pedido"
                        android:textColor="@color/black"
                        android:textColorHint="#999999"
                        android:layout_marginBottom="8dp"/>

                    <!-- Projeto -->
                    <TextView
                        android:id="@+id/lbl_projeto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/projeto"
                        android:textColor="@color/black"
                        android:textSize="14sp" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <Spinner
                            android:id="@+id/spinner_projetos"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                        <CheckBox
                            android:id="@+id/chk_listar_todos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/listar_todos"
                            android:textColor="@color/black"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <!-- Data do Pedido -->
                    <TextView
                        android:id="@+id/lbl_data_pedido"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/data_pedido"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <EditText
                            android:id="@+id/edt_data_inicio"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/hint_data"
                            android:inputType="date"
                            android:focusable="false"
                            android:autofillHints="none"
                            android:textColor="@color/black"
                            android:textColorHint="#999999"
                            android:labelFor="@id/lbl_data_pedido" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/data_ate"
                            android:textColor="@color/black"
                            android:layout_gravity="center_vertical"/>
                        <EditText
                            android:id="@+id/edt_data_fim"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/hint_data"
                            android:inputType="date"
                            android:focusable="false"
                            android:autofillHints="none"
                            android:textColor="@color/black"
                            android:textColorHint="#999999"
                            android:labelFor="@id/lbl_data_pedido" />
                    </LinearLayout>

                    <!-- === CAMPOS EXCLUSIVOS DE COMPRA/SERVIÇO === -->
                    <LinearLayout
                        android:id="@+id/layout_campos_compra"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Produto -->
                        <TextView
                            android:id="@+id/lbl_produto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/produto"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:layout_marginTop="8dp"/>
                        <EditText
                            android:id="@+id/edt_produto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:autofillHints="none"
                            android:hint="@string/produto"
                            android:textColor="@color/black"
                            android:textColorHint="#999999"
                            android:layout_marginBottom="8dp"/>

                        <!-- Número Processo Compra -->
                        <TextView
                            android:id="@+id/lbl_num_processo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/num_processo_compra"
                            android:textColor="@color/black"
                            android:textSize="14sp" />
                        <EditText
                            android:id="@+id/edt_num_processo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:autofillHints="none"
                            android:hint="@string/num_processo_compra"
                            android:textColor="@color/black"
                            android:textColorHint="#999999"
                            android:layout_marginBottom="8dp"/>

                        <!-- Número AF/OS -->
                        <TextView
                            android:id="@+id/lbl_num_af_os"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/num_af_os"
                            android:textColor="@color/black"
                            android:textSize="14sp" />
                        <EditText
                            android:id="@+id/edt_num_af_os"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:autofillHints="none"
                            android:hint="@string/num_af_os"
                            android:textColor="@color/black"
                            android:textColorHint="#999999"
                            android:layout_marginBottom="8dp"/>

                        <!-- Fornecedor -->
                        <TextView
                            android:id="@+id/lbl_fornecedor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fornecedor"
                            android:textColor="@color/black"
                            android:textSize="14sp" />
                        <EditText
                            android:id="@+id/edt_fornecedor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:autofillHints="none"
                            android:hint="@string/fornecedor"
                            android:textColor="@color/black"
                            android:textColorHint="#999999"
                            android:layout_marginBottom="4dp"/>

                        <!-- Solicitante -->
                        <TextView
                            android:id="@+id/lbl_solicitante"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/solicitante"
                            android:textColor="@color/black"
                            android:textSize="14sp" />
                        <EditText
                            android:id="@+id/edt_solicitante"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:autofillHints="none"
                            android:hint="@string/solicitante"
                            android:textColor="@color/black"
                            android:textColorHint="#999999"
                            android:layout_marginBottom="8dp"/>
                    </LinearLayout>

                    <!-- === CAMPOS EXCLUSIVOS DE PAGAMENTO === -->
                    <LinearLayout
                        android:id="@+id/layout_campos_pagamento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <!-- Tipo do Pedido -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tipo_pedido"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:layout_marginTop="8dp"/>
                        <Spinner
                            android:id="@+id/spinner_tipo_pedido"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:layout_marginBottom="8dp"/>

                        <!-- Favorecido -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/favorecido"
                            android:textColor="@color/black"
                            android:textSize="14sp" />
                        <EditText
                            android:id="@+id/edt_favorecido"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:autofillHints="none"
                            android:hint="@string/favorecido"
                            android:textColor="@color/black"
                            android:textColorHint="#999999"
                            android:layout_marginBottom="8dp"/>

                        <!-- Valor do Pedido -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/valor_pedido"
                            android:textColor="@color/black"
                            android:textSize="14sp" />
                        <EditText
                            android:id="@+id/edt_valor_pedido"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:autofillHints="none"
                            android:hint="@string/valor_pedido"
                            android:textColor="@color/black"
                            android:textColorHint="#999999"
                            android:layout_marginBottom="8dp"/>
                    </LinearLayout>

                    <!-- Campos comuns -->

                        <!-- Situação -->
                    <TextView
                        android:id="@+id/lbl_situacao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/situacao"
                        android:textColor="@color/black"
                        android:textSize="14sp" />
                    <Spinner
                        android:id="@+id/spinner_situacao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_marginBottom="16dp"/>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_consultar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            app:backgroundTint="@color/azul_conveniar"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            android:text="@string/botao_consultar" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <ListView
                    android:id="@+id/list_consultas"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="16dp"
                    android:background="@android:color/transparent"
                    android:cacheColorHint="@android:color/transparent"
                    android:divider="#33000000"
                    android:dividerHeight="1dp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/header_menu_lateral"
        app:menu="@menu/menu_lateral_opcoes" />

</androidx.drawerlayout.widget.DrawerLayout>