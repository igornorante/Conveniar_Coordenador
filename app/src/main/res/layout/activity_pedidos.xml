<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- CONTEÚDO PRINCIPAL -->
        <RelativeLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- HEADER -->
            <include
                android:id="@+id/header_pedidos"
                layout="@layout/header_geral"/>

            <TextView
                android:id="@+id/txt_pedidos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/header_pedidos"
                android:background="@color/azul_conveniar"
                android:text="Pedidos"
                android:textSize="25sp"
                android:textAlignment="center"
                android:padding="5dp"
                android:textColor="@color/white"/>

            <ListView
                android:id="@+id/list_opcoes_pedidos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/txt_pedidos"
                android:divider="#33000000"
                android:dividerHeight="1dp"/>

        </RelativeLayout>


    <!-- MENU LATERAL -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#EDEDED"
        app:headerLayout="@layout/header_menu_lateral"
        app:itemIconTint="@null"
        app:itemTextColor="@color/black"
        app:menu="@menu/menu_lateral_opcoes"/>

</androidx.drawerlayout.widget.DrawerLayout>