<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F8FAFC">

        <include layout="@layout/header_geral" />

        <TextView
            android:id="@+id/txt_titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/azul_conveniar"
            android:padding="8dp"
            android:text="Central de Pedidos"
            android:textAlignment="center"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selecione o tipo de solicitação"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="16dp"/>

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:alignmentMode="alignMargins"
                    android:columnOrderPreserved="false">

                    <!-- Pedido de Compra -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_compra"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/icone_compra"
                                app:tint="@color/azul_conveniar" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Compra/Serviço"
                                android:layout_marginTop="8dp"
                                android:textSize="12sp"
                                android:textAlignment="center"
                                android:textColor="#333333" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Adiantamento -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_adiantamento"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/icone_adiantamento"
                                app:tint="@color/azul_conveniar" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Adiantamento"
                                android:layout_marginTop="8dp"
                                android:textSize="12sp"
                                android:textAlignment="center"
                                android:textColor="#333333" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Acerto de Adiantamento -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_acerto_adiantamento"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/icone_acertoadiantamento"
                                app:tint="@color/azul_conveniar" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Acerto Adiant."
                                android:layout_marginTop="8dp"
                                android:textSize="12sp"
                                android:textAlignment="center"
                                android:textColor="#333333" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Reembolso -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_reembolso"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/icone_reembolso"
                                app:tint="@color/azul_conveniar" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Reembolso"
                                android:layout_marginTop="8dp"
                                android:textSize="12sp"
                                android:textAlignment="center"
                                android:textColor="#333333" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Diária -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_diaria"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/icone_diaria"
                                app:tint="@color/azul_conveniar" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Diária/Frete"
                                android:layout_marginTop="8dp"
                                android:textSize="12sp"
                                android:textAlignment="center"
                                android:textColor="#333333" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Pagamento de Bolsa -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_bolsa"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/icone_pag_bolsa"
                                app:tint="@color/azul_conveniar" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pagto. Bolsa"
                                android:layout_marginTop="8dp"
                                android:textSize="12sp"
                                android:textAlignment="center"
                                android:textColor="#333333" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Pagamento PJ -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_pag_pj"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/icone_pag_juridica"
                                app:tint="@color/azul_conveniar" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pessoa Jurídica"
                                android:layout_marginTop="8dp"
                                android:textSize="12sp"
                                android:textAlignment="center"
                                android:textColor="#333333" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Pagamento PF -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_pag_pf"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/icone_pag_fisica"
                                app:tint="@color/azul_conveniar" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pessoa Física"
                                android:layout_marginTop="8dp"
                                android:textSize="12sp"
                                android:textAlignment="center"
                                android:textColor="#333333" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Entrada de Receita -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_receita"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/icone_entradareceita"
                                app:tint="@color/azul_conveniar" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Entrada Receita"
                                android:layout_marginTop="8dp"
                                android:textSize="12sp"
                                android:textAlignment="center"
                                android:textColor="#333333" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Transferência -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_transferencia"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/icone_transferencia"
                                app:tint="@color/azul_conveniar" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Transferência"
                                android:layout_marginTop="8dp"
                                android:textSize="12sp"
                                android:textAlignment="center"
                                android:textColor="#333333" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Parecer Técnico -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_parecer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/icone_parecer"
                                app:tint="@color/azul_conveniar" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Parecer Técnico"
                                android:layout_marginTop="8dp"
                                android:textSize="12sp"
                                android:textAlignment="center"
                                android:textColor="#333333" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Bolsa em Lote -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_bolsa_lote"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/icone_bolsalote"
                                app:tint="@color/azul_conveniar" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bolsa em Lote"
                                android:layout_marginTop="8dp"
                                android:textSize="12sp"
                                android:textAlignment="center"
                                android:textColor="#333333" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Ordem AF/OS -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_ordem"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/icone_ordem"
                                app:tint="@color/azul_conveniar" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ordem AF/OS"
                                android:layout_marginTop="8dp"
                                android:textSize="12sp"
                                android:textAlignment="center"
                                android:textColor="#333333" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Contratação -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_contratacao"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/icone_contratacao"
                                app:tint="@color/azul_conveniar" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Contratação"
                                android:layout_marginTop="8dp"
                                android:textSize="12sp"
                                android:textAlignment="center"
                                android:textColor="#333333" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </GridLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="60dp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/header_menu_lateral"
        app:menu="@menu/menu_lateral_opcoes" />

</androidx.drawerlayout.widget.DrawerLayout>
