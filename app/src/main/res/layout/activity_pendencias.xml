<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F7F7F7">

        <include
            android:id="@+id/header_pendencias"
            layout="@layout/header_geral" />

        <TextView
            android:id="@+id/txt_titulo_pendencias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/header_pendencias"
            android:background="@color/azul_conveniar"
            android:padding="10dp"
            android:text="Pendências"
            android:textAlignment="center"
            android:textColor="@android:color/white"
            android:textSize="20sp" />

        <LinearLayout
            android:id="@+id/tabs_pendencias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/txt_titulo_pendencias"
            android:background="@android:color/white"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_suas_pendencias"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="12dp"
                android:text="Suas pendências"
                android:textColor="@color/azul_conveniar"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackground"/>

            <TextView
                android:id="@+id/tab_pendencias_fundacao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="12dp"
                android:text="Pendências da fundação"
                android:textColor="#999999"
                android:background="?attr/selectableItemBackground"/>
        </LinearLayout>

        <View
            android:id="@+id/tab_indicator"
            android:layout_width="150dp"
            android:layout_height="3dp"
            android:layout_below="@id/tabs_pendencias"
            android:layout_marginStart="20dp"
            android:background="@color/azul_conveniar" />

        <ExpandableListView
            android:id="@+id/exp_list_pendencias"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/tab_indicator"
            android:divider="#EEEEEE"
            android:dividerHeight="1dp"
            android:groupIndicator="@null" />

        <ProgressBar
            android:id="@+id/progress_pendencias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:visibility="gone" />

    </RelativeLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation_view"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#EDEDED"
        app:headerLayout="@layout/header_menu_lateral"
        app:itemIconTint="@null"
        app:itemTextColor="@color/black"
        app:menu="@menu/menu_lateral_opcoes" />

</androidx.drawerlayout.widget.DrawerLayout>