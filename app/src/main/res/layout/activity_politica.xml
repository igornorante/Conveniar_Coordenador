<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".PoliticaActivity">

        <TextView
            android:id="@+id/txt_privacidade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Política de Privacidade"
            android:textAlignment="center"
            android:textSize="30dp"
            android:layout_centerHorizontal="true"
            android:background="@drawable/borda"
            >
        </TextView>

        <TextView
            android:id="@+id/texto_politica1"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_below="@+id/txt_privacidade"
            android:text="@string/texto_politica"
            android:layout_margin="10dp">
        </TextView>

        <Button
            android:id="@+id/politica_botao_sair"
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Fechar"
            android:backgroundTint="@color/azul_conveniar"
            android:layout_centerHorizontal="true"
            android:layout_below="@+id/texto_politica1">
        </Button>

    </RelativeLayout>
</ScrollView>